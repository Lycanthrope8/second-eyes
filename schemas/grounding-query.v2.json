{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grounding-query.v2.json",
  "title": "Grounding query v2 (A2.1e, D71)",
  "description": "Format 2 of the query record (A4): format 1 for perceived scenes only, with the evidence profile fixed to perceived wherever format 1 names one. A query is checked against format 2 only when it says format 2 and perceived; every other query and record stays format 1, exactly as before. A test keeps the two formats identical elsewhere (grounding/tests/test_resolution_v2.py).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "query_id",
    "scene_id",
    "scene_revision",
    "evidence_profile",
    "command_id",
    "interpretations"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "record_type": {
      "const": "grounding_query"
    },
    "query_id": {
      "$ref": "#/$defs/id"
    },
    "scene_id": {
      "$ref": "#/$defs/id"
    },
    "scene_revision": {
      "type": "integer",
      "minimum": 0
    },
    "evidence_profile": {
      "const": "perceived"
    },
    "command_id": {
      "$ref": "#/$defs/id"
    },
    "interpretations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/interpretation"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}(?![\\s\\S])"
    },
    "label": {
      "type": "string",
      "pattern": "^\\S(.*\\S)?(?![\\s\\S])"
    },
    "local_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "action": {
      "enum": [
        "GO_TO",
        "INSPECT"
      ]
    },
    "nullable_action": {
      "enum": [
        "GO_TO",
        "INSPECT",
        null
      ]
    },
    "interpretation": {
      "oneOf": [
        {
          "$ref": "#/$defs/query"
        },
        {
          "$ref": "#/$defs/unavailable"
        },
        {
          "$ref": "#/$defs/unsupported"
        }
      ]
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interpretation_id",
        "kind",
        "action",
        "root",
        "nodes"
      ],
      "properties": {
        "interpretation_id": {
          "$ref": "#/$defs/local_id"
        },
        "kind": {
          "const": "query"
        },
        "action": {
          "$ref": "#/$defs/action"
        },
        "root": {
          "$ref": "#/$defs/local_id"
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    },
    "unavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interpretation_id",
        "kind",
        "action",
        "reason"
      ],
      "properties": {
        "interpretation_id": {
          "$ref": "#/$defs/local_id"
        },
        "kind": {
          "const": "unavailable"
        },
        "action": {
          "$ref": "#/$defs/nullable_action"
        },
        "reason": {
          "const": "frame_interpretation_unavailable"
        }
      }
    },
    "unsupported": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interpretation_id",
        "kind",
        "action",
        "reason"
      ],
      "properties": {
        "interpretation_id": {
          "$ref": "#/$defs/local_id"
        },
        "kind": {
          "const": "unsupported"
        },
        "action": {
          "$ref": "#/$defs/nullable_action"
        },
        "reason": {
          "enum": [
            "unsupported_action",
            "unsupported_negation",
            "unsupported_disjunction",
            "unsupported_plural",
            "unsupported_temporal",
            "unsupported_coreference",
            "unsupported_visibility",
            "unsupported_size_comparison",
            "unsupported_numeric_comparison",
            "unsupported_composition"
          ]
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "category",
        "colours_all",
        "constraints",
        "rank"
      ],
      "properties": {
        "node_id": {
          "$ref": "#/$defs/local_id"
        },
        "category": {
          "oneOf": [
            {
              "$ref": "#/$defs/label"
            },
            {
              "type": "null"
            }
          ]
        },
        "colours_all": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/label"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/constraint"
          }
        },
        "rank": {
          "oneOf": [
            {
              "$ref": "#/$defs/rank"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "constraint": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "relation",
            "frame",
            "anchors"
          ],
          "properties": {
            "relation": {
              "enum": [
                "near",
                "above",
                "below",
                "on",
                "inside"
              ]
            },
            "frame": {
              "type": "null"
            },
            "anchors": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "$ref": "#/$defs/local_id"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "relation",
            "frame",
            "anchors"
          ],
          "properties": {
            "relation": {
              "const": "between"
            },
            "frame": {
              "type": "null"
            },
            "anchors": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/local_id"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "relation",
            "frame",
            "anchors"
          ],
          "properties": {
            "relation": {
              "enum": [
                "left",
                "right",
                "in_front_of",
                "behind"
              ]
            },
            "frame": {
              "const": "user_heading"
            },
            "anchors": {
              "type": "array",
              "maxItems": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "relation",
            "frame",
            "anchors"
          ],
          "properties": {
            "relation": {
              "enum": [
                "left",
                "right",
                "in_front_of",
                "behind"
              ]
            },
            "frame": {
              "enum": [
                "user_to_anchor",
                "object_intrinsic"
              ]
            },
            "anchors": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "$ref": "#/$defs/local_id"
              }
            }
          }
        }
      ]
    },
    "rank": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation",
        "anchor",
        "k"
      ],
      "properties": {
        "relation": {
          "enum": [
            "closest",
            "farthest"
          ]
        },
        "anchor": {
          "$ref": "#/$defs/local_id"
        },
        "k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      }
    }
  }
}
