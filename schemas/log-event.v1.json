{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "log-event.v1.json",
  "title": "Second Eyes event log line, format v1",
  "description": "One line of a session log (JSON Lines). The top level checks every line; each entry in $defs is the data schema of the event type with that name, and analysis/eventlog.py applies it to lines whose ev matches. Explained in docs/logging.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "seq",
    "mono_us",
    "utc_us",
    "ev",
    "data"
  ],
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 0,
      "description": "Line counter from 0 within one session file."
    },
    "mono_us": {
      "type": "integer",
      "minimum": 0,
      "description": "Device monotonic clock in integer microseconds; never jumps."
    },
    "utc_us": {
      "type": "integer",
      "minimum": 0,
      "description": "Wall clock as Unix time in integer microseconds; can jump when the clock is corrected."
    },
    "ev": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
      "description": "Event type in lower case, prefixed by its component, e.g. asr.text."
    },
    "data": {
      "type": "object",
      "description": "The event's own fields; a field with a unit carries it in its name, e.g. latency_ms."
    }
  },
  "$defs": {
    "session.start": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "session_id",
        "app_version",
        "os_build"
      ],
      "properties": {
        "format": {
          "const": 1,
          "description": "Log format version (1)."
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique ID of this session."
        },
        "app_version": {
          "type": "string",
          "minLength": 1,
          "description": "Version of the app that wrote the log."
        },
        "os_build": {
          "type": [
            "string",
            "null"
          ],
          "description": "Headset ro.build.fingerprint, or null on a device without one."
        }
      }
    },
    "session.end": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "mark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "The note."
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "where",
        "message"
      ],
      "properties": {
        "where": {
          "type": "string",
          "minLength": 1,
          "description": "Component or function where it happened."
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "description": "What went wrong."
        }
      }
    },
    "display.rate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_hz",
        "available_hz"
      ],
      "properties": {
        "requested_hz": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Refresh rate the app requested, in Hz."
        },
        "available_hz": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "description": "Refresh rates the headset offers, in Hz; empty if it didn't say."
        }
      }
    },
    "hands.state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "left_tracked",
        "right_tracked"
      ],
      "properties": {
        "left_tracked": {
          "type": "boolean",
          "description": "Whether the left hand is tracked."
        },
        "right_tracked": {
          "type": "boolean",
          "description": "Whether the right hand is tracked."
        }
      }
    },
    "control.stop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "What triggered the stop, e.g. button_b."
        }
      }
    },
    "model.load": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "copied",
        "ms",
        "backend",
        "execution_mode"
      ],
      "properties": {
        "file": {
          "type": [
            "string",
            "null"
          ],
          "description": "The .sentis file the provider loads (D34), or null if unknown."
        },
        "copied": {
          "type": "boolean",
          "description": "Whether this start first copied the model out of the app into its data folder."
        },
        "ms": {
          "type": "number",
          "minimum": 0,
          "description": "Time for the provider's warm-up, which includes any copy, in milliseconds."
        },
        "backend": {
          "type": "string",
          "minLength": 1,
          "description": "The chat's backend, e.g. CPU."
        },
        "execution_mode": {
          "type": "string",
          "minLength": 1,
          "description": "Blocking or NonBlocking."
        },
        "steps_per_frame": {
          "type": "integer",
          "minimum": 1,
          "description": "Steps per frame in NonBlocking mode."
        },
        "runtime": {
          "type": "string",
          "enum": [
            "unity",
            "llama.cpp"
          ],
          "description": "Which runtime loaded the model; absent means Meta's (A1.8c, D58)."
        },
        "threads": {
          "type": "integer",
          "minimum": 1,
          "description": "llama.cpp's CPU threads."
        },
        "llama_cpp": {
          "type": "string",
          "description": "llama.cpp's release, e.g. b11277 (eae11d22)."
        },
        "memory_kb": {
          "type": "integer",
          "minimum": 0,
          "description": "The app's resident memory right after loading, in KB."
        }
      }
    },
    "model.setting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repeat",
        "pause_s"
      ],
      "properties": {
        "repeat": {
          "type": "boolean",
          "description": "Whether the panel's Repeat is on: it sends the chosen prompt again a pause after each answer (D50)."
        },
        "steps_per_frame": {
          "type": "integer",
          "minimum": 1,
          "description": "Meta's steps per frame from now on; its prompt pass uses half."
        },
        "pause_s": {
          "type": "number",
          "minimum": 0,
          "description": "Repeat's pause after each answer, in seconds."
        },
        "threads": {
          "type": "integer",
          "minimum": 1,
          "description": "llama.cpp's CPU threads from now on (A1.8c)."
        }
      },
      "description": "Written whenever the panel's Repeat or Steps setting changes; the setting at a model.load is off and that event's steps_per_frame."
    },
    "model.generate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "prompt_id",
        "answer",
        "answer_tokens",
        "first_token_ms",
        "total_ms",
        "stopped"
      ],
      "properties": {
        "request": {
          "type": "integer",
          "minimum": 1,
          "description": "Which send this belongs to, counted from 1 in each session."
        },
        "prompt_id": {
          "type": "string",
          "minLength": 1,
          "description": "As in the request."
        },
        "answer": {
          "type": "string",
          "description": "The answer text, as streamed."
        },
        "answer_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of answer tokens streamed."
        },
        "first_token_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "From the request to the first answer token, in milliseconds; null if none came."
        },
        "total_ms": {
          "type": "number",
          "minimum": 0,
          "description": "From the request to the end of the answer, in milliseconds."
        },
        "stopped": {
          "type": "boolean",
          "description": "Whether Stop ended the answer early."
        }
      }
    },
    "model.scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "prompt_id",
        "candidates",
        "best",
        "ms"
      ],
      "description": "llama.cpp: each object the prompt lists, scored after the answer's start (A1.8c, D56, D58).",
      "properties": {
        "request": {
          "type": "integer",
          "minimum": 1
        },
        "prompt_id": {
          "type": "string",
          "minLength": 1
        },
        "candidates": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "number"
          },
          "description": "Object ID to the log-probability of the ID and the closing '\"}'."
        },
        "best": {
          "type": "string",
          "minLength": 1
        },
        "ms": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "model.message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "text"
      ],
      "properties": {
        "level": {
          "enum": [
            "warning",
            "error"
          ],
          "description": "The message's level in Unity's log."
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "What Meta's on-device code logged, e.g. a truncated prompt."
        }
      }
    },
    "model.request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "prompt_id",
        "prompt_tokens",
        "prompt_token_ids"
      ],
      "properties": {
        "request": {
          "type": "integer",
          "minimum": 1,
          "description": "Which send this belongs to, counted from 1 in each session."
        },
        "prompt_id": {
          "type": "string",
          "minLength": 1,
          "description": "The fixed prompt's ID if it was sent unedited, else typed."
        },
        "prompt_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of prompt tokens after the chat template."
        },
        "prompt_token_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "description": "The prompt's token IDs, from the provider's own template and tokenizer."
        },
        "runtime": {
          "type": "string",
          "enum": [
            "unity",
            "llama.cpp"
          ],
          "description": "Absent means Meta's runner."
        },
        "cached_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "llama.cpp: how many of the prompt's tokens came from the cache (the scene)."
        },
        "scene_ms": {
          "type": "number",
          "minimum": 0,
          "description": "llama.cpp: time to evaluate the scene when it wasn't cached; 0 otherwise."
        }
      }
    },
    "model.token": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "index",
        "text",
        "ms"
      ],
      "properties": {
        "request": {
          "type": "integer",
          "minimum": 1,
          "description": "Which send this belongs to, counted from 1 in each session."
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "description": "The answer token's position, from 0."
        },
        "text": {
          "type": "string",
          "description": "The token's text, as Meta's runner decodes it."
        },
        "ms": {
          "type": "number",
          "minimum": 0,
          "description": "From the request to this token, in milliseconds."
        }
      }
    },
    "ui.keyboard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "chars"
      ],
      "properties": {
        "event": {
          "enum": [
            "opened",
            "open_failed",
            "done",
            "canceled",
            "lost_focus",
            "unsupported"
          ],
          "description": "What the system keyboard did."
        },
        "chars": {
          "type": "integer",
          "minimum": 0,
          "description": "Length of the text box's text at that moment."
        }
      }
    },
    "camera.permission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "granted"
      ],
      "properties": {
        "granted": {
          "type": "boolean",
          "description": "Whether the headset-camera permission is granted (A1.10a)."
        }
      }
    },
    "camera.resolutions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "camera",
        "supported"
      ],
      "properties": {
        "camera": {
          "enum": [
            "left",
            "right"
          ],
          "description": "Which passthrough camera."
        },
        "supported": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "description": "Supported [width, height] pairs, or null when the component returned none."
        }
      }
    },
    "camera.toggle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "on",
        "source"
      ],
      "properties": {
        "on": {
          "type": "boolean",
          "description": "Whether the camera was asked to run."
        },
        "source": {
          "enum": [
            "button_x",
            "launch"
          ],
          "description": "What asked: X on the left controller, or Start On Launch."
        }
      }
    },
    "camera.state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Whether MRUK's camera component is now enabled."
        }
      }
    },
    "camera.playing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "frame_signal"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 0,
          "description": "Frame width in pixels."
        },
        "height": {
          "type": "integer",
          "minimum": 0,
          "description": "Frame height in pixels."
        },
        "frame_signal": {
          "enum": [
            "updated_flag",
            "timestamp",
            "none"
          ],
          "description": "How new frames are told apart: the component's IsUpdatedThisFrame, its Timestamp, or not at all."
        }
      }
    },
    "camera.second": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "on",
        "playing",
        "frames",
        "window_ms",
        "width",
        "height"
      ],
      "properties": {
        "on": {
          "type": "boolean",
          "description": "Whether the camera is wanted on."
        },
        "playing": {
          "type": "boolean",
          "description": "Whether frames are arriving."
        },
        "frames": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Distinct frames in this window, or null without a frame signal."
        },
        "window_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Length of this window in milliseconds (about 1000)."
        },
        "width": {
          "type": "integer",
          "minimum": 0,
          "description": "Frame width, 0 when not playing."
        },
        "height": {
          "type": "integer",
          "minimum": 0,
          "description": "Frame height, 0 when not playing."
        }
      }
    },
    "detector.toggle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "on",
        "source"
      ],
      "properties": {
        "on": {
          "type": "boolean",
          "description": "Whether the detector was asked to run (A1.10c)."
        },
        "source": {
          "enum": [
            "button_y",
            "context_menu"
          ],
          "description": "Y on the left controller, or the component's context menu in the Editor."
        }
      }
    },
    "detector.backend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "source"
      ],
      "properties": {
        "backend": {
          "enum": [
            "gpu_compute",
            "cpu"
          ],
          "description": "The backend now selected; it applies the next time the detector starts."
        },
        "source": {
          "enum": [
            "left_thumbstick"
          ],
          "description": "Pressing the left thumbstick while the detector is off."
        }
      }
    },
    "detector.load": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_id",
        "model_sha256",
        "backend",
        "input_size",
        "load_ms",
        "warmup_ms",
        "warmup_completed",
        "color_space"
      ],
      "properties": {
        "package_id": {
          "type": "string",
          "description": "The detector package's ID (D84)."
        },
        "model_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "The model file's SHA-256 as the package manifest states it."
        },
        "backend": {
          "enum": [
            "gpu_compute",
            "cpu"
          ],
          "description": "Unity Inference Engine backend: GPUCompute or CPU."
        },
        "input_size": {
          "type": "integer",
          "minimum": 1,
          "description": "The model's square input size in pixels."
        },
        "load_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "Reading the manifest, loading the model and creating the worker."
        },
        "warmup_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "The first inference, on a uniform pad-coloured canvas; it includes one-time setup."
        },
        "warmup_completed": {
          "type": "boolean",
          "description": "Whether that first inference finished."
        },
        "color_space": {
          "enum": [
            "linear",
            "gamma"
          ],
          "description": "The project's colour space."
        },
        "layer_count": {
          "type": "integer",
          "minimum": 0,
          "description": "The model's layer count after import: scheduling steps per inference (D88)."
        },
        "steps_per_frame": {
          "type": "integer",
          "minimum": 0,
          "description": "Scheduling steps per rendered frame; 0: the whole network in one frame."
        },
        "floor": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "Lowest score kept after suppression, for parity's threshold-crossing checks."
        },
        "mode": {
          "enum": [
            "scan",
            "sequential",
            "diagnostic",
            "profile",
            "burst",
            "continuous"
          ],
          "description": "scan: stop-and-shoot keyframes in hover blocks; burst: a short higher-rate run; continuous: back to back."
        },
        "keyframe_rate_hz": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "Keyframe rate of the scan or burst mode."
        },
        "schedule_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "The frozen schedule in use (D89), or null for a fixed number of steps per frame."
        }
      }
    },
    "detector.unload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend"
      ],
      "properties": {
        "backend": {
          "enum": [
            "gpu_compute",
            "cpu"
          ],
          "description": "The backend of the detector released when it was turned off."
        },
        "release_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "Time to dispose the detector's worker, tensors and textures (D88)."
        },
        "in_flight": {
          "type": "boolean",
          "description": "Whether an inference was still running when it was released (false when it finished first)."
        }
      }
    },
    "detector.source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "graphics_format",
        "srgb",
        "width",
        "height",
        "encode_srgb",
        "flip"
      ],
      "properties": {
        "path": {
          "enum": [
            "camera",
            "texture_srgb",
            "texture_linear"
          ],
          "description": "Which texture path the next results use."
        },
        "graphics_format": {
          "type": "string",
          "description": "The source texture's GraphicsFormat."
        },
        "srgb": {
          "type": "boolean",
          "description": "Whether that format is sRGB."
        },
        "width": {
          "type": "integer",
          "minimum": 0
        },
        "height": {
          "type": "integer",
          "minimum": 0
        },
        "encode_srgb": {
          "type": "boolean",
          "description": "Whether the letterbox shader encodes samples back to sRGB values (linear colour space and an sRGB source)."
        },
        "flip": {
          "type": "boolean",
          "description": "Whether the source's rows are read bottom to top."
        }
      }
    },
    "detector.result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "image_id",
        "backend",
        "completed",
        "error",
        "width",
        "height",
        "ratio",
        "schedule_ms",
        "latency_ms",
        "postprocess_ms",
        "frames_waited",
        "candidates",
        "detections_total",
        "detections",
        "snapshot"
      ],
      "properties": {
        "path": {
          "enum": [
            "tensor",
            "texture_srgb",
            "texture_linear",
            "camera"
          ],
          "description": "tensor: an exact test canvas (the parity path); texture_*: a full-size test image through the GPU letterbox; camera: a passthrough frame."
        },
        "image_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "The test image's ID (reference.v1.json), null for camera frames."
        },
        "backend": {
          "enum": [
            "gpu_compute",
            "cpu"
          ],
          "description": "Unity Inference Engine backend: GPUCompute or CPU."
        },
        "readback": {
          "enum": [
            "blocking",
            "async"
          ],
          "description": "blocking: outputs read back synchronously in the inference's frame (the warm-up and self-checks); async: over the following frames (camera frames by default). Absent in logs from builds before the second A1.10c fix."
        },
        "completed": {
          "type": "boolean",
          "description": "Whether the inference finished."
        },
        "error": {
          "type": [
            "string",
            "null"
          ],
          "description": "Why it did not run, for example busy."
        },
        "width": {
          "type": "integer",
          "minimum": 0,
          "description": "Source width in pixels."
        },
        "height": {
          "type": "integer",
          "minimum": 0,
          "description": "Source height in pixels."
        },
        "ratio": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "Letterbox ratio: input pixels per source pixel."
        },
        "schedule_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "From the start to the model being scheduled: letterbox, conversion, scheduling (CPU wall time)."
        },
        "latency_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "From the start until all three outputs were read back."
        },
        "postprocess_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "Thresholding and suppression on the CPU."
        },
        "frames_waited": {
          "type": "integer",
          "minimum": 0,
          "description": "Frames spent waiting for the readbacks."
        },
        "candidates": {
          "type": "integer",
          "minimum": 0,
          "description": "Outputs at or above the score threshold before suppression."
        },
        "detections_total": {
          "type": "integer",
          "minimum": 0,
          "description": "Detections after suppression; at most maxLoggedDetections are listed."
        },
        "detections": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 6,
            "maxItems": 6,
            "items": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "description": "[class, score, x1, y1, x2, y2] in source pixels, highest score first."
        },
        "snapshot": {
          "type": [
            "string",
            "null"
          ],
          "description": "The saved input's name (snapshots/<name>.png beside the logs), or null."
        },
        "steps_per_frame": {
          "type": "integer",
          "minimum": 0,
          "description": "Scheduling steps per rendered frame for this inference (0: all in one frame)."
        },
        "schedule_steps": {
          "type": "integer",
          "minimum": 0,
          "description": "Scheduling steps this inference took (runtime layers)."
        },
        "schedule_frames": {
          "type": "integer",
          "minimum": 0,
          "description": "Rendered frames its scheduling spanned."
        },
        "floor": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "Lowest score kept; detections are those at or above the package threshold (0.3)."
        },
        "keyframe": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Keyframe number in this session (null for self-checks)."
        },
        "scan": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Scan number (scan mode), else null."
        },
        "hover": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Hover block within the scan, else null."
        },
        "requested_utc_us": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "When the keyframe came due (UTC microseconds, the log's clock), null for self-checks."
        },
        "started_utc_us": {
          "type": "integer",
          "minimum": 0,
          "description": "When the inference copied its image and started (UTC microseconds)."
        },
        "capture_stamp": {
          "type": [
            "string",
            "null"
          ],
          "description": "The camera frame's timestamp as the camera component reports it, or null."
        },
        "pose": {
          "type": [
            "array",
            "null"
          ],
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": [
              "number",
              "null"
            ]
          },
          "description": "Camera pose at capture: x, y, z, qx, qy, qz, qw; null when unavailable."
        },
        "start_frame": {
          "type": "integer",
          "minimum": 0,
          "description": "Frame of the inference's preprocessing (D89)."
        },
        "schedule_end_frame": {
          "type": "integer",
          "minimum": 0,
          "description": "Frame of its last scheduling step."
        },
        "end_frame": {
          "type": "integer",
          "minimum": 0,
          "description": "Frame its readbacks completed."
        },
        "preprocess_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "Letterbox and conversion (or the exact canvas upload), CPU wall time."
        },
        "schedule_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "The frozen schedule used for a camera keyframe, else null."
        }
      },
      "description": "Fields added in D88 (steps, keyframe, capture identity) are absent in earlier logs."
    },
    "detector.setting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "mode",
        "steps_per_frame",
        "source"
      ],
      "properties": {
        "backend": {
          "enum": [
            "gpu_compute",
            "cpu"
          ]
        },
        "mode": {
          "enum": [
            "scan",
            "sequential",
            "diagnostic",
            "profile",
            "burst",
            "continuous"
          ],
          "description": "scan: stop-and-shoot keyframes in hover blocks; burst: a short higher-rate run; continuous: back to back."
        },
        "steps_per_frame": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "The control that changed it."
        },
        "schedule_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "The chosen schedule (D89), or null."
        }
      }
    },
    "detector.scan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scan",
        "hover",
        "state",
        "requested",
        "completed",
        "rejected"
      ],
      "properties": {
        "scan": {
          "type": "integer",
          "minimum": 0
        },
        "hover": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Hover block, or null for the whole scan."
        },
        "state": {
          "enum": [
            "start",
            "end"
          ]
        },
        "requested": {
          "type": "integer",
          "minimum": 0
        },
        "completed": {
          "type": "integer",
          "minimum": 0
        },
        "rejected": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "detector.reject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "scan",
        "hover",
        "requested_utc_us"
      ],
      "properties": {
        "reason": {
          "enum": [
            "busy",
            "no_camera_frame"
          ],
          "description": "busy: an inference was in flight; never queued."
        },
        "scan": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "hover": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "requested_utc_us": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "frame.second": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window_ms",
        "frames",
