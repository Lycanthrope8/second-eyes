{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capture.v1.json",
  "title": "Second Eyes capture record, format v1",
  "description": "One scan on the headset (A4): the camera with its intrinsics, the detector with its exact settings and the identities of the category map, size priors and perception folder the scan used, the clock mapping, and every keyframe with its frame ID, capture time, the camera's pose in quest_tracking at capture as Unity reports it, the tracking epoch and state, the detections from that same frame, and the image when image saving is on. Written and checked on the headset (CaptureCheck.cs); a perceived scene (scene v3) is built from it, and the localization can be rerun on the PC from it. Rules: docs/capture-record.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "capture_id",
    "camera",
    "app",
    "detector",
    "configuration",
    "clock",
    "tracking_frame",
    "camera_pose_convention",
    "nominal_step_deg",
    "keyframes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "capture"
    },
    "capture_id": {
      "$ref": "#/$defs/id"
    },
    "camera": {
      "$ref": "#/$defs/camera"
    },
    "app": {
      "$ref": "#/$defs/app"
    },
    "detector": {
      "$ref": "#/$defs/detector"
    },
    "configuration": {
      "$ref": "#/$defs/configuration"
    },
    "clock": {
      "$ref": "#/$defs/clock"
    },
    "tracking_frame": {
      "const": "quest_tracking"
    },
    "camera_pose_convention": {
      "const": "unity_camera_to_quest_tracking",
      "description": "Each keyframe's camera_pose maps Unity's camera axes (unity_camera: x right, y up, z forward) into quest_tracking; both are left-handed, so the rotation is proper. The optical frame and the scene are reached only through UnityBasis (docs/frames.md)."
    },
    "nominal_step_deg": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "The turn the scan procedure asks for between steps at one position; a keyframe's nominal angle is step_index x nominal_step_deg."
    },
    "keyframes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/keyframe"
      },
      "minItems": 1
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}(?![\\s\\S])",
      "description": "Lower-case identifier: letters, digits, '_', '.', '-'; starts with a letter or digit."
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(.*\\S)?(?![\\s\\S])",
      "description": "A non-empty label without leading or trailing whitespace."
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "vec3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "quat": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
      "description": "A SHA-256 in lower-case hex."
    },
    "camera": {
      "description": "The camera that took the keyframes. Intrinsics follow OpenCV's pixel convention (docs/frames.md); source says where they came from.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "camera_id",
        "width_px",
        "height_px",
        "intrinsics",
        "distortion"
      ],
      "properties": {
        "camera_id": {
          "$ref": "#/$defs/id"
        },
        "width_px": {
          "type": "integer",
          "minimum": 1
        },
        "height_px": {
          "type": "integer",
          "minimum": 1
        },
        "intrinsics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fx",
            "fy",
            "cx",
            "cy",
            "source"
          ],
          "properties": {
            "fx": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "fy": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "cx": {
              "type": "number"
            },
            "cy": {
              "type": "number"
            },
            "source": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "distortion": {
          "enum": [
            "none",
            "unknown"
          ],
          "description": "none: the images carry no lens distortion (stated by the source); unknown: not stated."
        }
      }
    },
    "app": {
      "description": "The app build that wrote the record.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build"
      ],
      "properties": {
        "build": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "keyframe": {
      "description": "One stop of the scan: its frame ID and place in the scan (index, standing position, step at that position), its capture time, the tracking epoch and state, the camera's pose at capture, the detections the detector made on this very frame, and the image.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "frame_id",
        "position_index",
        "step_index",
        "capture_time",
        "tracking",
        "camera_pose",
        "detections",
        "image"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "frame_id": {
          "$ref": "#/$defs/id",
          "description": "Unique within the capture; it ties the image, its pose and its detections together."
        },
        "position_index": {
          "type": "integer",
          "minimum": 0
        },
        "step_index": {
          "type": "integer",
          "minimum": 0
        },
        "capture_time": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sdk_value",
            "headset_mono_us"
          ],
          "properties": {
            "sdk_value": {
              "type": "integer",
              "minimum": 0
            },
            "headset_mono_us": {
              "type": "integer",
              "minimum": 0
            }
          },
          "description": "The SDK's own timestamp for the image, in clock.sdk_unit, and the same moment on the event log's monotonic clock."
        },
        "tracking": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "epoch",
            "state"
          ],
          "properties": {
            "epoch": {
              "type": "integer",
              "minimum": 0
            },
            "state": {
              "enum": [
                "tracked",
                "not_tracked"
              ]
            }
          }
        },
        "camera_pose": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "translation_m",
            "rotation_xyzw"
          ],
          "properties": {
            "translation_m": {
              "$ref": "#/$defs/vec3"
            },
            "rotation_xyzw": {
              "$ref": "#/$defs/quat"
            }
          },
          "description": "The camera's pose in quest_tracking as Unity reports it: position p and rotation q (docs/frames.md)."
        },
        "detections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/detection"
          }
        },
        "image": {
          "$ref": "#/$defs/image"
        }
      }
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "score",
        "box_px"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/label"
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "box_px": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4,
          "description": "x1, y1, x2, y2 in the source image's pixels (detector.boxes); not clipped."
        }
      }
    },
    "image": {
      "description": "The keyframe's image, when image saving is on: its file name and SHA-256.",
      "type": "object",
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "saved",
            "not_saved"
          ]
        }
      },
      "if": {
        "required": [
          "state"
        ],
        "properties": {
          "state": {
            "const": "saved"
          }
        }
      },
      "then": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state",
          "file",
          "sha256"
        ],
        "properties": {
          "state": {
            "const": "saved"
          },
          "file": {
            "$ref": "#/$defs/text"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      },
      "else": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state"
        ],
        "properties": {
          "state": {
            "const": "not_saved"
          }
        }
      }
    },
    "detector": {
      "description": "The detector package and the settings that produced the detections, as in its manifest (detector-package.json).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_id",
        "package_sha256",
        "input_px",
        "letterbox",
        "score_threshold",
        "nms",
        "nms_iou_threshold",
        "boxes"
      ],
      "properties": {
        "package_id": {
          "$ref": "#/$defs/id"
        },
        "package_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "input_px": {
          "type": "integer",
          "minimum": 1
        },
        "letterbox": {
          "const": "top_left"
        },
        "score_threshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "nms": {
          "const": "class_agnostic_greedy"
        },
        "nms_iou_threshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "boxes": {
          "const": "source_pixels_unclipped",
          "description": "Boxes are in the source image's pixels: the model's input-pixel boxes divided by the letterbox ratio, not clipped, so a box may run past the image's edge."
        }
      }
    },
    "configuration": {
      "description": "The identities of what turned detections into a scene on the headset.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "perception_folder_sha256",
        "category_map_id",
        "size_priors_id"
      ],
      "properties": {
        "perception_folder_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "category_map_id": {
          "$ref": "#/$defs/id"
        },
        "size_priors_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "clock": {
      "description": "How the SDK's image timestamps map to the event log's monotonic clock: headset_mono_us = the SDK value in microseconds (rounded down) + offset_us.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sdk_unit",
        "offset_us"
      ],
      "properties": {
        "sdk_unit": {
          "enum": [
            "ns",
            "us",
            "ms",
            "100ns"
          ]
        },
        "offset_us": {
          "type": "integer"
        }
      }
    }
  }
}
