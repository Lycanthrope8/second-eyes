# Operating systems
.DS_Store
Thumbs.db
desktop.ini

# Python (used from S0.2)
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Large files never go into Git (docs/conventions.md, rule 4)
# video and audio
*.mp4
*.mov
*.avi
*.mkv
*.h264
*.wav
*.flac
# model weights
*.onnx
*.gguf
*.safetensors
*.pt
*.pth
*.ckpt
*.sentis
*.sentis.meta
# point clouds and motion capture
*.ply
*.c3d
# builds and archives
*.apk
*.aab
*.zip

# Downloaded and exported models: grounding/models/<name>.json is tracked, grounding/models/<name>/ is not
/grounding/models/*/
*.onnx_data

# Unity project in quest-app/ (created in A1)
/quest-app/[Ll]ibrary/
/quest-app/[Tt]emp/
/quest-app/[Oo]bj/
/quest-app/[Bb]uild/
/quest-app/[Bb]uilds/
/quest-app/[Ll]ogs/
/quest-app/[Uu]ser[Ss]ettings/
/quest-app/[Mm]emoryCaptures/
/quest-app/[Rr]ecordings/
/quest-app/*.csproj
/quest-app/*.sln
/quest-app/.vs/
/quest-app/.idea/
/quest-app/.vscode/
/quest-app/*.user
/quest-app/*.userprefs
/quest-app/*.pidb
/quest-app/sysinfo.txt
/quest-app/crashlytics-build.properties
# Unity's temporary folder for Android native build caches
/quest-app/.utmp/
# Written by the build and removed again when it finishes (seen in A1.4a)
/quest-app/Assets/Resources/PerformanceTestRun*
# Unity build side-products, created next to the APK
*_BurstDebugInformation_DoNotShip/
*_BackUpThisFolder_ButDontShipItWithYourGame/
# StreamingAssets holds only the converted model (A1.7c, D35, D38), recreated with docs/setup/quest-model.md
/quest-app/Assets/StreamingAssets/
/quest-app/Assets/StreamingAssets.meta

# Run data stays out of Git until raw-data storage is decided (open item O9)
/runs/*/raw/

# llama.cpp (A1.8b, D55): the pinned checkout, build folders and built binaries are recreated by tools/build_llama.py
/third_party/
/build/
/native/out/
